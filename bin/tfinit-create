#!/usr/bin/env bash

set -u

usage() {
        cat <<'EOF'
Usage: tfinit-create <gcp|azure> <environment>...

Create a .tfinit file in the current Terraform root module.

Backends:
    gcp      Prompt for a GCS bucket and state prefix
    azure    Prompt for a resource group, storage account, and blob container

Examples:
    tfinit-create gcp dev nprd prod
    tfinit-create azure dev prod

The command asks before replacing an existing .tfinit file.
EOF
}

prompt_required() {
    local prompt=$1
    local variable_name=$2
    local value

    while true; do
        read -r -p "$prompt: " value || exit 1
        if [[ -n $value ]]; then
            printf -v "$variable_name" '%s' "$value"
            return
        fi
        echo "A value is required." >&2
    done
}

escape_double_quoted() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//\$/\\$}
    value=${value//\`/\\\`}
    printf '%s' "$value"
}

case ${1:-} in
    -h | --help)
        usage
        exit 0
        ;;
esac

if [[ $# -lt 2 ]]; then
    usage >&2
    exit 4
fi

backend=$1
shift
environments=("$@")

case $backend in
    gcp | azure) ;;
    *)
        usage >&2
        exit 4
        ;;
esac

for environment in "${environments[@]}"; do
    if [[ ! $environment =~ ^[[:alnum:]_.-]+$ ]]; then
        echo "Invalid environment '$environment': use letters, numbers, dots, underscores, or hyphens" >&2
        exit 5
    fi
done

config_file="$PWD/.tfinit"
if [[ -e $config_file ]]; then
    read -r -p "Overwrite '$config_file'? [y/N] " answer || exit 1
    case $answer in
        y | Y | yes | YES) ;;
        *)
            echo "Not changed: $config_file" >&2
            exit 1
            ;;
    esac
fi

bucket=
prefix=
resource_group=
storage_account=
container=

if [[ $backend = gcp ]]; then
    prompt_required "GCS bucket" bucket
    read -r -p "State prefix [tfstate]: " prefix || exit 1
    prefix=${prefix:-tfstate}
    prefix=${prefix#/}
    prefix=${prefix%/}
    if [[ -z $prefix ]]; then
        echo "State prefix cannot be empty" >&2
        exit 6
    fi
else
    prompt_required "Azure resource group" resource_group
    prompt_required "Azure storage account" storage_account
    prompt_required "Azure blob container" container
fi

temporary_file=$(mktemp "$PWD/.tfinit.XXXXXX") || exit 1
trap 'rm -f "$temporary_file"' EXIT

{
    printf '# Generated by tfinit-create for %s.\n' "$backend"
    for environment in "${environments[@]}"; do
        if [[ $backend = gcp ]]; then
            escaped_bucket=$(escape_double_quoted "$bucket")
            escaped_prefix=$(escape_double_quoted "$prefix")
            printf "state_location[\"%s\"]=\"%s/%s/\${folder_name}/\${env}\"\n" \
                "$environment" "$escaped_bucket" "$escaped_prefix"
        else
            escaped_resource_group=$(escape_double_quoted "$resource_group")
            escaped_storage_account=$(escape_double_quoted "$storage_account")
            escaped_container=$(escape_double_quoted "$container")
            printf 'state_location["%s"]="%s/%s/%s"\n' \
                "$environment" "$escaped_resource_group" "$escaped_storage_account" "$escaped_container"
        fi
    done
} >"$temporary_file"

mv "$temporary_file" "$config_file"
trap - EXIT
echo "Created $config_file"